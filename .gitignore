# Dependencies — installed via npm install on each machine
node_modules/

# Build outputs — regenerated by npm run build
dist/
electron-dist/
release/
release-android/

# Generated preview image (we keep icon.svg and icon.ico as sources)
public/icon-preview.png

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Env files (any secrets)
.env
.env.local
.env.*.local

# TypeScript build info
*.tsbuildinfo

# electron-builder cache (also lives in user AppData but skip if any local copy)
.electron-cache/

# Android (Capacitor) build artifacts. The android/ folder itself is committed
# (Gradle config, native shell, plugins). These subpaths are generated.
android/.gradle/
android/build/
android/app/build/
android/app/release/
android/captures/
android/local.properties
android/.idea/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/capacitor-cordova-android-plugins/

# Claude Code / planning artifacts
.claude/

# Local song test data — large audio files outside the demo set.
# These are the user's personal Paradiddle library used for testing,
# not project assets. The real song library lives in IndexedDB at runtime.
/Songs/
/diddle/

# Unrelated third-party reference tool the user keeps in this folder
/ParadiddleUtilities-master/
